{
  "Configuration.h": [
    {
      "op": "InsertAfter",
      "searchfor": "#pragma once",
      "newline": "\n// Created by xXHenneBXx\n// Based on Recreator by Josh Taylor\n"
    },
    {
      "op": "Custom",
      "searchfor": "STRING_CONFIG_H_AUTHOR",
      "mask": "\".*\"",
      "value": "\"xXHenneBXx\""
    },
    {
      "op": "Custom",
      "searchfor": "CUSTOM_MACHINE_NAME",
      "mask": "\".*\"",
      "value": "\"~RECREATOR~\"",
      "comment": "Custom machine name for pultrusion"
    },
    {
      "op": "Enable",
      "searchfor": "CONFIGURABLE_MACHINE_NAME",
      "comment": "Allow M550 to set/report machine name"
    },
    {
      "op": "CustomVal",
      "searchfor": "TEMP_SENSOR_0",
      "value": "13",
      "comment": "100k Hisens 3950 1% up to 300C"
    },
    {
      "op": "CustomVal",
      "searchfor": "TEMP_SENSOR_BED",
      "value": "0",
      "comment": "No heatbed in pultrusion system"
    },
    {
      "op": "CustomVal",
      "searchfor": "HEATER_0_MINTEMP",
      "value": "5"
    },
    {
      "op": "CustomVal",
      "searchfor": "HEATER_0_MAXTEMP",
      "value": "275",
      "comment": "Pultrusion hotend max"
    },
    {
      "op": "CustomVal",
      "searchfor": "EXTRUDE_MAXLENGTH",
      "value": "10000",
      "comment": "Allow long continuous extrusion for pultrusion"
    },
    {
      "op": "Custom",
      "searchfor": "DEFAULT_AXIS_STEPS_PER_UNIT",
      "mask": "{.*}",
      "value": "{ 80, 80, 400, 93 }",
      "comment": "Pultrusion default steps per unit"
    },
    {
      "op": "Custom",
      "searchfor": "DEFAULT_MAX_FEEDRATE",
      "mask": "{.*}",
      "value": "{ 500, 500, 10, 25 }",
      "comment": "Pultrusion feedrates"
    },
    {
      "op": "CustomVal",
      "searchfor": "DEFAULT_ACCELERATION",
      "value": "500",
      "comment": "Gentle acceleration for steady pull"
    },
    {
      "op": "CustomVal",
      "searchfor": "DEFAULT_RETRACT_ACCELERATION",
      "value": "500"
    },
    {
      "op": "CustomVal",
      "searchfor": "DEFAULT_TRAVEL_ACCELERATION",
      "value": "800"
    },
    {
      "op": "CustomVal",
      "searchfor": "DEFAULT_EJERK",
      "value": "5.0",
      "comment": "Steady extrusion jerk"
    },
    {
      "op": "CustomVal",
      "searchfor": "X_BED_SIZE",
      "value": "220"
    },
    {
      "op": "CustomVal",
      "searchfor": "Y_BED_SIZE",
      "value": "220"
    },
    {
      "op": "CustomVal",
      "searchfor": "X_MIN_POS",
      "value": "0"
    },
    {
      "op": "CustomVal",
      "searchfor": "Y_MIN_POS",
      "value": "0"
    },
    {
      "op": "CustomVal",
      "searchfor": "X_MAX_POS",
      "value": "245"
    },
    {
      "op": "CustomVal",
      "searchfor": "Y_MAX_POS",
      "value": "220"
    },
    {
      "op": "CustomVal",
      "searchfor": "Z_MAX_POS",
      "value": "250"
    },
    {
      "op": "Custom",
      "searchfor": "PREHEAT_1_LABEL",
      "mask": "\".*\"",
      "value": "\"PET\"",
      "comment": "PET preheat preset"
    },
    {
      "op": "CustomVal",
      "searchfor": "PREHEAT_1_TEMP_HOTEND",
      "value": "240",
      "comment": "PET preheat temp"
    },
    {
      "op": "CustomVal",
      "searchfor": "PREHEAT_1_TEMP_BED",
      "value": "0",
      "comment": "No bed"
    },
    {
      "op": "Custom",
      "searchfor": "PREHEAT_2_LABEL",
      "mask": "\".*\"",
      "value": "\"PETE\"",
      "comment": "PETE high-temp preheat"
    },
    {
      "op": "CustomVal",
      "searchfor": "PREHEAT_2_TEMP_HOTEND",
      "value": "255",
      "comment": "PETE preheat temp"
    },
    {
      "op": "CustomVal",
      "searchfor": "PREHEAT_2_TEMP_BED",
      "value": "0",
      "comment": "No bed"
    },
    {
      "op": "CustomVal",
      "searchfor": "PROBING_MARGIN",
      "value": "10",
      "comment": "Required by PROUI_EX"
    },
    {
      "op": "InsertAfter",
      "searchfor": "#pragma once",
      "newline": "\n#ifndef GRID_MAX_POINTS_X\n  #define GRID_MAX_POINTS_X 4\n#endif\n#ifndef GRID_MAX_POINTS_Y\n  #define GRID_MAX_POINTS_Y GRID_MAX_POINTS_X\n#endif\n"
    },
    {
      "op": "Enable",
      "searchfor": "Z_SAFE_HOMING",
      "comment": "Required for Marlin build"
    },
    {
      "op": "Enable",
      "searchfor": "EEPROM_SETTINGS",
      "comment": "Persistent settings storage"
    },
    {
      "op": "Enable",
      "searchfor": "SDSUPPORT",
      "comment": "SD card support"
    },
    {
      "op": "Enable",
      "searchfor": "DWIN_LCD_PROUI",
      "comment": "Pro UI - display configs build on this"
    },
    {
      "op": "Custom",
      "searchfor": "FILAMENT_RUNOUT_SCRIPT",
      "mask": "\".*\"",
      "value": "\"M0\"",
      "comment": "Stop on runout - no M600 since ADVANCED_PAUSE is disabled"
    },
    {
      "op": "CustomVal",
      "searchfor": "FIL_RUNOUT_ENABLED_DEFAULT",
      "value": "false",
      "comment": "Runout disabled by default - many users have no sensor"
    },
    {
      "op": "InsertAfter",
      "searchfor": "#pragma once",
      "newline": "\n#if ENABLED(DWIN_LCD_PROUI)\n  #if PROUI_EX\n    #define HAS_TOOLBAR 1\n  #endif\n  #define HAS_CUSTOM_COLORS 1\n  #define HAS_CUSTOM_COLORS_MENU 1\n  #define HAS_PLOT 1\n  #define HAS_ESDIAG 1\n  #define HAS_LOCKSCREEN 1\n  #define HAS_FLOW_EDIT 1\n  #define HAS_FEEDRATE_EDIT 1\n  #define PREVIEW_MENU_ITEM\n  #define SHOW_REAL_POS\n  #define RUNOUT_TUNE_ITEM\n  #define PLR_TUNE_ITEM\n  #define MEDIASORT_MENU_ITEM\n  #define SHOW_SPEED_IND\n  #define NO_BLINK_IND\n#endif\n#define ZOFFSET_SAVE_SETTINGS"
    },
    {
      "op": "InsertAfter",
      "searchfor": "#pragma once",
      "newline": "#define PROUI_EX 1\n#if PROUI_EX\n  #if ENABLED(FILAMENT_RUNOUT_SENSOR)\n    #define HAS_PROUI_RUNOUT_SENSOR 1\n  #endif\n  #if ENABLED(EXTRUDERS)\n    #define HAS_PROUI_MAXTEMP 1\n  #endif\n  #define HAS_CGCODE 1\n#endif"
    }
  ],
  "Configuration_adv.h": [
    {
      "op": "InsertAfter",
      "searchfor": "#pragma once",
      "newline": "\n// Created by xXHenneBXx\n// PET Pultrusion Configurator\n"
    },
    {
      "op": "Enable",
      "searchfor": "GCODE_QUOTED_STRINGS",
      "comment": "Required by CONFIGURABLE_MACHINE_NAME"
    },
    {
      "op": "Enable",
      "searchfor": "SHOW_BOOTSCREEN",
      "comment": "Show boot screen on startup"
    },
    {
      "op": "CustomVal",
      "searchfor": "BOOTSCREEN_TIMEOUT",
      "value": "1100",
      "comment": "Boot screen display duration"
    },
    {
      "op": "Enable",
      "searchfor": "SHOW_CUSTOM_BOOTSCREEN",
      "comment": "Show custom boot screen bitmap"
    },
    {
      "op": "Enable",
      "searchfor": "CUSTOM_STATUS_SCREEN_IMAGE",
      "comment": "Show custom status screen bitmap"
    },
    {
      "op": "Disable",
      "searchfor": "ADVANCED_PAUSE_FEATURE",
      "comment": "Not needed - nozzle does not move in pultrusion"
    },
    {
      "op": "CustomVal",
      "searchfor": "RETRACT_LENGTH",
      "value": "3",
      "comment": "Pultrusion default retract"
    },
    {
      "op": "CustomVal",
      "searchfor": "RETRACT_FEEDRATE",
      "value": "40"
    },
    {
      "op": "CustomVal",
      "searchfor": "RETRACT_RECOVER_FEEDRATE",
      "value": "40"
    },
    {
      "op": "CustomVal",
      "searchfor": "MIN_STEPS_PER_SEGMENT",
      "value": "2",
      "comment": "Fine pultrusion movement"
    }
  ],
  "Version.h": [
    {
      "op": "InsertAfter",
      "searchfor": "#pragma once",
      "newline": "\n// Created by xXHenneBXx\n// Based on Recreator by Josh Taylor\n"
    },
    {
      "op": "Custom",
      "searchfor": "SHORT_BUILD_VERSION",
      "mask": "\".*\"",
      "value": "\"2.1.4 PET-Pultrusion\""
    },
    {
      "op": "Custom",
      "searchfor": "SOURCE_CODE_URL",
      "mask": "\".*\"",
      "value": "\"github.com/xXHenneBXx/Pultrusion\""
    },
    {
      "op": "Custom",
      "searchfor": "WEBSITE_URL",
      "mask": "\".*\"",
      "value": "\"github.com/xXHenneBXx/Pultrusion/wiki\""
    }
  ]
}
